{
    "success": {
        "generic": {
            "type": "text",
            "value": "Operation successful."
        }
    },
    "error": {
        "generic": {
            "type": "text",
            "value": "An error occurred."
        }
    },
    "account": {
        "suspended": {
            "_type": "audience_text",
            "_variants": [
                "individual",
                "corporate"
            ],
            "_params": [
                "remaining_time"
            ],
            "individual": "Your account has been temporarily suspended due to suspicious activity. You can regain access in :remaining_time.",
            "corporate": "Your company account has been temporarily suspended due to suspicious activity. Access will be restored in :remaining_time."
        }
    },
    "user": {
        "gender": {
            "_type": "enum",
            "_values": [
                "male",
                "female",
                "unspecified"
            ],
            "_fields": [
                "label"
            ],
            "male": {
                "label": "Male"
            },
            "female": {
                "label": "Female"
            },
            "unspecified": {
                "label": "Prefer not to say"
            }
        },
        "session_verification_method": {
            "_type": "enum",
            "_values": [
                "otp_only",
                "password_only",
                "otp_and_password"
            ],
            "_fields": [
                "title",
                "description"
            ],
            "otp_only": {
                "title": "OTP Only",
                "description": "Verification is done using a one-time password."
            },
            "password_only": {
                "title": "Password Only",
                "description": "Login is done using only your email password."
            },
            "otp_and_password": {
                "title": "Password & OTP",
                "description": "Both email password and one-time password are required."
            }
        }
    },
    "greet": {
        "_type": "rich_text",
        "_components": [
            "mark"
        ],
        "_params": [
            "age"
        ],
        "_nodes": [
            {
                "_type": "text",
                "value": "Hello, I am "
            },
            {
                "_type": "mark",
                "_children": [
                    {
                        "_type": "text",
                        "_params": [
                            "age"
                        ],
                        "value": ":age"
                    }
                ]
            },
            {
                "_type": "text",
                "value": " years old"
            }
        ]
    }
}