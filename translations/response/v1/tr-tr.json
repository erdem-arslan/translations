{
    "auth": {
        "invalid_credentials": {
            "_type": "text",
            "_params": null,
            "value": "Giriş bilgileriniz hatalı. Lütfen tekrar deneyiniz."
        },
        "already_exist": {
            "_type": "text",
            "_params": [
                "field"
            ],
            "value": "Bu :field başka bir hesap tarafından kullanılmaktadır."
        },
        "not_exist": {
            "_type": "text",
            "_params": [
                "field"
            ],
            "value": "Girilen :field sistemde kayıtlı değildir."
        },
        "same_as_current": {
            "_type": "text",
            "_params": [
                "field"
            ],
            "value": "Güncellemek istediğiniz :field mevcut değeriniz ile aynıdır."
        },
        "already_verified": {
            "_type": "text",
            "_params": [
                "field"
            ],
            "value": "Bu :field zaten doğrulanmıştır."
        },
        "user_suspended_until": {
            "_type": "audience_text",
            "_variants": [
                "individual",
                "corporate"
            ],
            "_params": [
                "field",
                "remaining_time"
            ],
            "individual": "Hesabın askıya alındı. :field kontrol et. :remaining_time sonra tekrar dene.",
            "corporate": "Hesabınız askıya alınmıştır. :field kontrol ediniz. :remaining_time sonra tekrar deneyiniz."
        },
        "password_in_history": {
            "_type": "audience_text",
            "_variants": [
                "individual",
                "corporate"
            ],
            "_params": [
                "count"
            ],
            "individual": "Yeni şifren son :count şifrenden farklı olmalıdır.",
            "corporate": "Yeni şifreniz son :count şifrenizden farklı olmalıdır."
        },
        "account_status": {
            "_type": "enum",
            "_values": [
                "active",
                "inactive",
                "suspended"
            ],
            "_fields": [
                "label",
                "description"
            ],
            "active": {
                "label": "Aktif",
                "description": "Hesap aktif ve kullanılabilir durumda."
            },
            "inactive": {
                "label": "Pasif",
                "description": "Hesap henüz etkinleştirilmemiş."
            },
            "suspended": {
                "label": "Askıya alındı",
                "description": "Hesap geçici olarak askıya alınmış."
            }
        },
        "verify_prompt": {
            "_type": "rich_text",
            "_components": [
                "Link"
            ],
            "_params": [
                "field"
            ],
            "_nodes": [
                {
                    "_type": "text",
                    "value": "Lütfen :field doğrulamak için ",
                    "_params": [
                        "field"
                    ]
                },
                {
                    "_type": "Link",
                    "_children": [
                        {
                            "_type": "text",
                            "value": "buraya tıklayın",
                            "_params": []
                        }
                    ]
                },
                {
                    "_type": "text",
                    "value": ".",
                    "_params": []
                }
            ]
        }
    }
}